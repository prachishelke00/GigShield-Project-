# MST Blockchain Testnet Configuration
# Target Chain ID: 91562037 (0x5752035)
MST_RPC=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037

# Deployer / Verifier Private Key (Do NOT commit real keys with funds)
# For local or testnet, paste your 64-character private key (without 0x prefix or with)
VERIFIER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# Deployed Contract Addresses (Filled automatically after running deployment script)
GIGSHIELD_ADDRESS=
GST_TOKEN_ADDRESS=

# Backend Oracle Service Port
BACKEND_PORT=3001

# Hosted rider profile storage (required on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MST Mainnet deployment (separate from Testnet; do not reuse testnet keys)
# Official RPC: https://mariorpc.mstblockchain.com
# Chain ID: 4646 (0x1226); native currency: MSTC
MAINNET_RPC_URL=https://mariorpc.mstblockchain.com
MAINNET_DEPLOYER_PRIVATE_KEY=
# Set after the guarded Mainnet deployment outputs the fixed-supply GST token address.
MAINNET_GST_TOKEN_ADDRESS=
# Use a separately secured production verifier address; do not use a simulator key.
MAINNET_VERIFIER_ADDRESS=

# Backend Mainnet selection (configure only after production review)
BLOCKCHAIN_NETWORK=testnet
MAINNET_GIGSHIELD_ADDRESS=
MAINNET_VERIFIER_PRIVATE_KEY=
